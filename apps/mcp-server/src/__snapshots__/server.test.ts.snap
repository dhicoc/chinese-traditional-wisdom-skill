    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "测字/字占：输入一个汉字，分析康熙笔画数理（81 数理吉凶）、字义五行、字义本义（说文/形声）、字形结构（上下/左右/包围/独体）与偏旁象义，可选结合八字用神判断该字对日主的补益。输出吉凶定调+性格预示+事业/感情影响+改字起名建议。象数+字义占卜，门槛最低。",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "aspect": {
          "description": "问题方向（默认综合）",
          "enum": [
            "事业",
            "感情",
            "财利",
            "健康",
            "综合",
          ],
          "type": "string",
        },
        "baziTimeContext": {
          "additionalProperties": false,
          "description": "仅提供 birth 时必填：八字用神补益判断的时间来源",
          "properties": {
            "calibrationToken": {
              "description": "resolve_true_solar_time 在当前 MCP 进程签发的真太阳时校准令牌",
              "format": "uuid",
              "type": "string",
            },
            "civilFallbackConfirmed": {
              "const": true,
              "description": "民用时间降级须为 true，表示用户已确认未完成真太阳时复核",
              "type": "boolean",
            },
            "timeBasis": {
              "enum": [
                "true-solar-verified",
                "civil-unverified",
              ],
              "type": "string",
            },
          },
          "required": [
            "timeBasis",
          ],
          "type": "object",
        },
        "birth": {
          "additionalProperties": false,
          "description": "可选生辰，结合八字用神补益判断",
          "properties": {
            "day": {
              "description": "公历日",
              "maximum": 31,
              "minimum": 1,
              "type": "integer",
            },
            "gender": {
              "description": "性别",
              "enum": [
                "男",
                "女",
              ],
              "type": "string",
            },
            "hour": {
              "description": "公历时（0-23）",
              "maximum": 23,
              "minimum": 0,
              "type": "integer",
            },
            "minute": {
              "description": "分钟（可选）",
              "maximum": 59,
              "minimum": 0,
              "type": "integer",
            },
            "month": {
              "description": "公历月",
              "maximum": 12,
              "minimum": 1,
              "type": "integer",
            },
            "year": {
              "description": "公历年",
              "maximum": 2100,
              "minimum": 1900,
              "type": "integer",
            },
          },
          "required": [
            "year",
            "month",
            "day",
            "hour",
            "gender",
          ],
          "type": "object",
        },
        "char": {
          "description": "所测汉字（取首字）",
          "maxLength": 4,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "char",
      ],
      "type": "object",
    },
