              "maximum": 59,
              "minimum": 0,
              "type": "integer",
            },
            "month": {
              "description": "公历月",
              "maximum": 12,
              "minimum": 1,
              "type": "integer",
            },
            "year": {
              "description": "公历年",
              "maximum": 2100,
              "minimum": 1900,
              "type": "integer",
            },
